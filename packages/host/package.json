{
  "name": "@deep-agent/host",
  "version": "0.1.0",
  "description": "The deep-agent RLM host: agent loop, sessions, children, goals, HTTP+SSE server",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "node scripts/sync-bundled-skills.cjs"
  },
  "dependencies": {
    "@deep-agent/kernel": "workspace:*",
    "@deep-agent/provider": "workspace:*",
    "js-tiktoken": "^1.0.21"
  }
}
